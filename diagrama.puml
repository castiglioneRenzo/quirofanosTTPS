@startuml Diagrama
title Hospital Rossi
hide empty members

class Usuario {
    -email: String
    -password: String
    -nombre: String
    -apellido: String
    -servicio: Servicio
    -especialidad: EspecialidadMedica
    -cargo: CargoMedico
    -activo: Boolean
    -permisos: Permiso*
}

enum constants.EspecialidadMedica {
    **Catálogo de especialidades**
}

enum constants.Servicio {
    **Catálogo de servicios**
}

enum constants.CargoMedico {
    R1
    R2
    R3
    R4
    Cirujano
    Administrativo
    Jefe
}

enum constants.Permiso {
    **Tabla de permisos**
}

class Paciente {
    -nombre: String
    -apellido: String
    -fechaNacimiento: Date
    -dni: Integer
    -genero: Genero
    -obraSocial: ObraSocial
    -numeroObraSocial: Integer
    -nombreContacto: String
    -telefonoContacto: String
    -email: String
    -localidad: String
}

enum constants.Genero {
    MASCULINO
    FEMENINO
    OTRO
}

class ObraSocial {
    -nombre: String
    -description: String
    -activo: Boolean
    -modificadoEn: Date
}

class Ingreso {
    -paciente: Paciente
    -fechaIngreso: Date
    -servicio: Servicio
    -prioridad: NivelPrioridad
    -diagnostico: Diagnostico
    -descripción: String
    -cirugia: Cirugia
    -nivelRiesgo: Integer
    -antecedentes: String
    -medicación: String
    -comentarios: String
}

enum constants.Diagnostico {
    **Catálogo de diagnósticos**
}

class Estudio {
    -descripcion: String
}

class Prequirurgico {
    ' -estudio: Estudio
    -completado: Boolean
}

class Cirugia {
    -reserva: Reserva
    -paciente: Paciente
    -procedimiento: String
    ' -servicio: Servicio
    -tipo: TipoCirugia
    -cirujano: Usuario
    -prequirurgicos: Prequirurgico
    -tipoAnestesia: TipoAnestesia
    -estado: EstadoCirugia
    -epicrisis: Epicrisis
    -evolucion: Seguimiento
    -seguimientoAmbulatorio: SeguimientoAmbulatorio
}

enum constants.EstadoCirugia {
    PROGRAMADA
    PENDIENTE
    FINALIZADA
}

class Quirofano {
    -nombre: String
    -servicio: Servicio
    -reservado: Boolean
    -tipo: TipoAnestesia
    -especialidad: [DiaDeSemana, RangoHorario, Especialidad]*
}

class Reserva {
    -fechaHoraInicio: DateTime
    -fechaHoraFin: DateTime
    -quirofano: Quirofano
    -estado: EstadoReserva
}

enum constants.EstadoReserva {
    PENDIENTE
    EN_CURSO
    REALIZADA
    CANCELADA
}

enum constants.TipoAnestesia {
    LOCAL
    GENERAL
}

enum constants.TipoCirugia {
    HOSPITALIZACION
    AMBULATORIO
}

enum constants.NivelPrioridad {
    CRITICO
    ALTO
    MEDIO
    BAJO
}

class Seguimiento {
    -fecha: Date
    -habitacion: String
    -cirujano: Usuario
    -tratamiento: String
    -evolucion: String
}

class SeguimientoAmbulatorio {
    -fecha: Date
    -medico: Usuario
    -tratamiento: String
    -comentario: String
}

class Epicrisis {
    -archivo: String
    -fecha: Date
}

Paciente "0..*" -- "1" ObraSocial
Ingreso "1..*" -- "1" Paciente
Ingreso "1" -- "0..*" Cirugia
Ingreso "0..*" -- "1" Usuario
Cirugia "1" *-- "0..*" Prequirurgico
Estudio "1..*" -- "0..*" Prequirurgico
Cirugia "1" -- "1" Usuario
Cirugia "1" *-- "0..*" SeguimientoAmbulatorio
Cirugia "1" o-- "0..*" Seguimiento
Cirugia "1" o-- "0..1" Epicrisis
Reserva "0..1" -- "1" Cirugia
Reserva "0..*" -- "1" Quirofano

@enduml